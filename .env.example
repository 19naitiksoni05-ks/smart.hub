# Smart Hub Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your own production credentials.

# Application Port
PORT=5000

# JSON Web Token Secret (Generate a strong 64-character random string)
JWT_SECRET=your_jwt_secret_key_generate_random_64_chars

# Supabase Project Credentials
# Project Settings -> API -> Project URL & Project API Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# GitHub OAuth App Credentials (Optional: GitHub Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Google OAuth App Credentials (Optional: Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Email SMTP for Verification OTP & Password Reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_verified_sender_email@gmail.com
SMTP_PASS=your_gmail_app_password_16_chars
SMTP_FROM="Smart Hub Support" <noreply@smarthub.dev>

# Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
